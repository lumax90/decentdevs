NEXT_PUBLIC_SITE_URL=https://decentdevs.com
# Optional verified public contact address.
NEXT_PUBLIC_CONTACT_EMAIL=

# Node 24 + persistent disk. Mount this directory in production.
DATA_DIR=./.data
# Set a long random secret before deployment (used to hash rate-limit keys).
RATE_LIMIT_SECRET=
# Set true only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Secret for the POST /api/internal/notifications maintenance endpoint.
CRON_SECRET=

# Transactional email, via Resend. Both must be set to enable delivery.
RESEND_API_KEY=
EMAIL_FROM=
# Optional studio copy of each project brief.
LEAD_NOTIFICATION_EMAIL=

# Internal Slack notifications. Incoming webhook or bot + channel.
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_LEADS_CHANNEL=

# "manual" records the customer's Slack preference in the team notification.
# "enterprise" creates a private project channel and sends a guest invitation.
# Enterprise requires a Slack Enterprise plan and an appropriately scoped admin token.
SLACK_INVITE_MODE=manual
SLACK_ADMIN_TOKEN=
SLACK_TEAM_ID=

# Narrated one-minute film. These keys are only used by local production scripts.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_SPEED=1.0
ELEVENLABS_STABILITY=0.36
ELEVENLABS_SIMILARITY=1.0
INTRO_MAX_PLAYBACK_SPEED=1.04
