{
  "name": "decent-devs",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "brand:render": "node scripts/brand/render-assets.mjs",
    "hero:assets": "node scripts/hero/download-assets.mjs",
    "hero:surface": "node scripts/hero/bake-surface.mjs",
    "hero:poster": "node scripts/hero/capture.mjs --poster",
    "hero:capture": "node scripts/hero/capture.mjs",
    "hero:tour-render": "node --import tsx scripts/hero/render-tour.mts",
    "hero:tour-studio": "remotion studio remotion/tour/index.tsx",
    "film:studio": "remotion studio remotion/index.ts",
    "film:render": "remotion render remotion/index.ts DecentFilm public/film/decent-devs.mp4 --codec=h264 --crf=18 --concurrency=2",
    "film:poster": "remotion still remotion/index.ts DecentFilm public/film/poster.jpg --frame=535",
    "audio:generate": "node scripts/generate-audio.mjs",
    "intro:voices": "node scripts/intro/voices.mjs",
    "intro:audition": "node scripts/intro/audition.mjs",
    "intro:narrate": "node scripts/intro/narrate.mjs",
    "intro:sound": "node scripts/intro/sound-assets.mjs",
    "intro:prepare": "node scripts/intro/prepare.mjs",
    "intro:studio": "remotion studio remotion/intro/index.ts",
    "intro:render": "node scripts/intro/render.mjs",
    "intro:approved": "node scripts/intro/music-preview.mjs --no-fx",
    "intro:poster": "node scripts/intro/poster.mjs",
    "intro:contact-sheet": "node scripts/intro/contact-sheet.mjs",
    "intro:verify": "node scripts/intro/verify.mjs",
    "leads:export": "tsx scripts/export-leads.ts",
    "notifications:retry": "tsx scripts/retry-notifications.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@react-three/fiber": "^9.8.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.52.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.63.0",
    "@remotion/bundler": "4.0.533",
    "@remotion/cli": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "remotion": "4.0.533",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  }
}
